BAI_API_KEY=
BAI_MODEL=gpt-6.1-sol
BAI_BASE_URL=https://api.b.ai/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# function (in-process) or mcp_stdio (local read-only MCP child process)
AGENT_TOOL_TRANSPORT=function

# Redis cache (falls back to in-process memory if unreachable)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_PREFIX=hksf
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
